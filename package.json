{
  "name": "family-chronicle",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Linked timeline and map built from a GEDCOM family tree, with historical context events.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "parse": "python scripts/parse_gedcom.py",
    "parse:demo": "python scripts/parse_gedcom.py demo/dummy.ged",
    "dev": "npm run parse && vite",
    "dev:demo": "npm run parse:demo && vite",
    "build": "npm run parse && vite build",
    "build:demo": "npm run parse:demo && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@fontsource/alegreya": "5.3.0",
    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "d3": "7.9.0",
    "topojson-client": "3.1.0",
    "vis-timeline": "7.7.3",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@types/d3": "7.4.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.19.1",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
