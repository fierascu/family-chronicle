{
  "name": "family-chronicle",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Linked timeline and map built from a GEDCOM family tree, with historical context events.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "node --test tests/*.test.ts",
    "archives": "node scripts/search-archives.ts",
    "translations": "node scripts/translations.ts"
  },
  "dependencies": {
    "@fontsource/alegreya": "5.3.0",
    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "d3": "7.9.0",
    "preact": "11.2.0",
    "topojson-client": "3.1.0",
    "vis-timeline": "^7.7.4",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/d3": "7.4.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.19.1",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "typescript": "5.9.3",
    "vite": "^7.3.7"
  }
}
